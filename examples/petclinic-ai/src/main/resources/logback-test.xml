<!-- Logging for the container-backed suites (integrationTest, chaosTest). SUT logs are prefixed by logger "sut". -->
<configuration>
  <appender name="OUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <logger name="io.github.vbilyi.llmresilience" level="INFO"/>
  <logger name="org.testcontainers" level="INFO"/>
  <logger name="tc" level="WARN"/>
  <logger name="org.mockserver" level="WARN"/>
  <logger name="sut" level="WARN"/>
  <root level="WARN"><appender-ref ref="OUT"/></root>
</configuration>
